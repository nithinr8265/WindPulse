# Application Settings
APP_NAME="WindPulse Wind Forecast Evaluation API"
APP_ENV="development"
PORT=8000
HOST="0.0.0.0"
LOG_LEVEL="INFO"

# CORS Configuration (comma-separated origins for frontend)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Elexon BMRS API Settings
# Base URL for Elexon BMRS API v1
ELEXON_BASE_URL="https://data.elexon.co.uk/bmrs/api/v1"
HTTP_TIMEOUT_SECONDS=30.0

# Forecast Decision Rule Settings
# In GB electricity trading, Day-Ahead gate closure typically occurs at 12:00 UTC (noon) on day D-1.
# This setting defines the cutoff hour on the day before the target delivery date (D-1).
DAY_AHEAD_DECISION_CUTOFF_HOUR=12
